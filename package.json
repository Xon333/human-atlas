{
  "name": "anatomy-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3016",
    "build": "vite build",
    "check": "tsc --noEmit",
    "serve:private": "node --experimental-strip-types server/private-runtime.mjs",
    "test:search": "node --experimental-strip-types --test scripts/search.test.mjs",
    "test:runtime": "node --experimental-strip-types --test scripts/private-runtime.test.mjs scripts/private-build-guard.test.mjs",
    "test:course": "node --experimental-strip-types scripts/validate-course.mjs && node --experimental-strip-types --test scripts/study-region.test.mjs",
    "test:geometry": "node --experimental-strip-types --test scripts/model-geometry.test.mjs",
    "test:scene": "node --experimental-strip-types --test scripts/scene-frame.test.mjs",
    "test:regions": "node --experimental-strip-types --test scripts/atlas-regions.test.mjs scripts/partition-anatomy.test.mjs scripts/region-navigation.test.mjs",
    "test:loading": "node --experimental-strip-types --test scripts/model-download.test.mjs scripts/scene-renderer.test.mjs scripts/scene-scope.test.mjs",
    "test:browser": "node --experimental-strip-types scripts/validate-region-first-browser.mjs",
    "test:browser:legacy": "node --experimental-strip-types scripts/validate-browser.mjs",
    "course:links": "node --experimental-strip-types scripts/course-links.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "^0.159.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.159.0",
    "@vitejs/plugin-react": "6.0.2",
    "meshoptimizer": "^1.2.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "license": "MIT"
}
